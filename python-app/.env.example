# Copy to .env and adjust as needed.

# Optional: Google PageSpeed Insights API key. If set, scans also pull a
# real performance/mobile-friendliness score from Google. Without it, the
# app still works using its own heuristics (HTTPS, viewport, CMS age, etc).
# Get a free key at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Contact email sent as part of the User-Agent when crawling business
# websites, per good-citizen scraping practice (so site owners can see who
# is visiting and why, and can ask to be excluded).
CRAWLER_CONTACT_EMAIL=you@example.com

# SQLite database file path.
DATABASE_URL=sqlite:///./marketplace.db
